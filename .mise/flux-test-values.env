# Stand-in values for the runtime variables Flux substitutes, one KEY=value
# per line. flux:lint and the component tests render with these; each
# environment computes the real ones in OpenTofu (runtime_info), and a test
# keeps the two key sets equal.
api_address=api.example.test
api_port=6443
kube_proxy_replacement=true
cilium_datapath_mode=netkit
cilium_operator_replicas=1
environment=lint
git_branch=main
