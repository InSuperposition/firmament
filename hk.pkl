amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

steps {
  ["shellcheck"] {
    check = "mise run check:shellcheck"
  }
  ["bats"] {
    check = "mise run check:bats"
  }
  ["tofu"] {
    check = "mise run local:fmt && mise run local:validate"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "git"
  }
}
