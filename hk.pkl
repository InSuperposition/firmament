amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Per-file linters and formatters. They run on the files a commit touches
// and fix what they can. shfmt takes its indentation from .editorconfig.
local fast = new Mapping<String, Step> {
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["tofu"] = Builtins.tofu
  ["mise"] = Builtins.mise
  // Fails on a secret (a private key, a token) in any file. The builtin
  // reads only files hk types as text, which leaves out a file without an
  // extension, such as an SSH key named id_ed25519.
  ["betterleaks"] = (Builtins.betterleaks) {
    types = null
  }
  // What each top-level folder may hold and name; see contracts/layout.
  ["layout"] {
    check = "mise run layout:lint"
  }
  // Every contract data file against its schema, and the rules that
  // span files. No glob: the files it reads may not exist yet.
  ["contracts"] {
    check = "mise run contracts:lint"
  }
  // Schema and read-only rules for the live cluster suites.
  ["chainsaw"] {
    glob = List("environments/*/tests/cluster/**/*.yaml", "packages/*/tests/cluster/**/*.yaml")
    check = "mise run chainsaw:lint"
  }
  // Renders and schema-validates each environment's Flux build.
  ["flux"] {
    glob = List("packages/**", "environments/*/flux/**", ".mise/flux-test-values.env", ".mise/flux-schemas/**")
    check = "mise run flux:lint"
  }
}

// Whole-repository checks, too slow for every commit. Each runs once, and
// only when a pushed change touches a file that can affect its result.
// Both initialize the same OpenTofu roots, and a fresh worktree has no
// module cache yet, so running them together races two module clones into
// one directory. `exclusive` runs each alone.
local slow = new Mapping<String, Step> {
  ["tofu-validate"] {
    glob = List("**/*.tf", "**/.terraform.lock.hcl")
    check = "mise run tofu:validate"
    exclusive = true
  }
  ["test"] {
    glob = List("**/*.tf", "**/*.tftest.hcl", "**/*.sh", "**/*.bash", "**/*.bats", "**/mise.toml", "hk.pkl", "contracts/**", "environments/*/environment.yaml", "environments/*/tests/machine-hosts.yaml", "environments/*/tests/cluster/**/*.yaml", "packages/**", "environments/*/flux/**", ".mise/flux-test-values.env", "environments/*/tests/upgrade-unaffected", ".mise/tests/fortio/**", ".mise/traffic/**")
    check = "mise run test"
    exclusive = true
  }
}

steps = fast

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
  }
  ["pre-push"] {
    steps {
      ...fast
      ...slow
    }
  }
}
